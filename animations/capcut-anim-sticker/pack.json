{
  "id": "capcut-anim-sticker",
  "name": "Clip animations: CapCut sticker",
  "version": "1.0.0",
  "items": [
    {
      "id": "fade-in",
      "name": "Fade In",
      "description": "Fades in (CapCut \"Fade In\"). Recreated and optimized with reference to CapCut's resources.",
      "kind": "in",
      "default_duration": 0.5,
      "applies_to": [
        "sticker"
      ],
      "curve": {
        "tracks": {
          "opacity": [
            {
              "t": 0,
              "value": 0,
              "ease": "easeOut"
            },
            {
              "t": 1,
              "value": 1
            }
          ]
        }
      }
    },
    {
      "id": "fade-out",
      "name": "Fade Out",
      "description": "Fades out (CapCut \"Fade Out\"). Recreated and optimized with reference to CapCut's resources.",
      "kind": "out",
      "default_duration": 0.5,
      "applies_to": [
        "sticker"
      ],
      "curve": {
        "tracks": {
          "opacity": [
            {
              "t": 0,
              "value": 1,
              "ease": "easeOut"
            },
            {
              "t": 1,
              "value": 0
            }
          ]
        }
      }
    },
    {
      "id": "rotate",
      "name": "Rotate",
      "description": "Turns a full circle clockwise per cycle (CapCut \"Rotate\"). Recreated and optimized with reference to CapCut's resources.",
      "kind": "loop",
      "default_duration": 0.5,
      "applies_to": [
        "sticker"
      ],
      "curve": {
        "tracks": {
          "rotation": [
            {
              "t": 0,
              "value": 0,
              "ease": "linear"
            },
            {
              "t": 1,
              "value": 360
            }
          ]
        }
      }
    },
    {
      "id": "flip",
      "name": "Flip",
      "description": "Turns around its vertical axis once per cycle, drawn as a flat width change without mirroring (CapCut \"Flip II\"). Recreated and optimized with reference to CapCut's resources.",
      "kind": "loop",
      "default_duration": 0.5,
      "applies_to": [
        "sticker"
      ],
      "curve": {
        "tracks": {
          "scaleX": [
            {
              "t": 0,
              "value": 1,
              "ease": "inSine"
            },
            {
              "t": 0.25,
              "value": 0,
              "ease": "outSine"
            },
            {
              "t": 0.5,
              "value": 1,
              "ease": "inSine"
            },
            {
              "t": 0.75,
              "value": 0,
              "ease": "outSine"
            },
            {
              "t": 1,
              "value": 1
            }
          ]
        }
      }
    }
  ]
}
