{
  "id": "flash",
  "name": "Flash",
  "description": "Fades in and out once per cycle (CapCut \"Flash\"). Recreated and optimized with reference to CapCut's resources.",
  "kind": "loop",
  "default_duration": 0.5,
  "curve": {
    "tracks": {
      "opacity": [
        {
          "t": 0,
          "value": 0,
          "ease": "easeOut"
        },
        {
          "t": 0.5,
          "value": 1,
          "ease": "easeIn"
        },
        {
          "t": 1,
          "value": 0
        }
      ]
    }
  }
}
